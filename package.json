{
  "name": "obi",
  "displayName": "Object Builder for IBM i (OBI)",
  "description": "Automated build tool for IBM i",
  "publisher": "andreas-prouza",
  "version": "1.5.4",
  "icon": "asserts/img/ext/logo.png",
  "keywords": [
    "ibm i",
    "ibmi",
    "iseries",
    "as400",
    "rpgle",
    "ile",
    "build"
  ],
  "author": {
    "name": "Andreas Prouza",
    "url": "https://www.prouza.at"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/andreas-prouza/obi-extension"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.obi/etc/app-config.toml"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "obi.clearDiagnostics",
        "title": "%obi.clearDiagnostics%",
        "icon": "$(clear-all)"
      },
      {
        "command": "obi.showErrors",
        "title": "%obi.showErrors%",
        "icon": "$(check-all)",
        "when": "obi.contains_obi_project && obi.valid-config"
      },
      {
        "command": "obi.show_changes",
        "title": "%obi.show_changes%",
        "icon": "$(loaded-scripts-view-icon)",
        "when": "obi.contains_obi_project && obi.valid-config",
        "enablement": "!obi.busy"
      },
      {
        "command": "obi.show_single_changes",
        "title": "%obi.show_single_changes%",
        "icon": "$(loaded-scripts-view-icon)",
        "when": "obi.contains_obi_project && obi.valid-config",
        "enablement": "!obi.busy"
      },
      {
        "command": "obi.run_build",
        "title": "%obi.run_build%",
        "icon": "$(run-all)",
        "when": "obi.contains_obi_project && obi.valid-config",
        "enablement": "!obi.busy"
      },
      {
        "command": "obi.run_single_build",
        "title": "%obi.run_single_build%",
        "icon": "$(run)",
        "when": "obi.contains_obi_project && obi.valid-config",
        "enablement": "!obi.busy"
      },
      {
        "command": "obi.add-source-to-build-summary",
        "title": "%obi.add-source-to-build-summary%",
        "icon": "$(add)",
        "when": "obi.contains_obi_project && obi.valid-config",
        "enablement": "!obi.busy"
      },
      {
        "command": "obi.source-filter.update",
        "title": "%obi.source-filter.update%",
        "icon": "$(refresh)",
        "when": "obi.contains_obi_project && obi.valid-config"
      },
      {
        "command": "obi.source-filter.add",
        "title": "%obi.source-filter.add%",
        "icon": "$(add)",
        "when": "obi.contains_obi_project && obi.valid-config"
      },
      {
        "command": "obi.get-remote-compiled-object-list",
        "title": "%obi.get-remote-compiled-object-list%",
        "icon": "$(arrow-circle-down)",
        "when": "obi.contains_obi_project && obi.valid-config && false"
      },
      {
        "command": "obi.copy-profile-config",
        "title": "%obi.copy-profile-config%",
        "icon": "$(person-add)",
        "when": "obi.contains_obi_project && obi.valid-config"
      },
      {
        "command": "obi.reset-compiled-object-list",
        "title": "%obi.reset-compiled-object-list%",
        "icon": "$(extensions)",
        "when": "obi.contains_obi_project && obi.valid-config",
        "enablement": "!obi.busy"
      },
      {
        "command": "obi.get-remote-build-results",
        "title": "%obi.get-remote-build-results%",
        "icon": "$(arrow-down)",
        "when": "obi.contains_obi_project && obi.valid-config && false",
        "enablement": "!obi.busy"
      },
      {
        "command": "obi.controller.config",
        "title": "%obi.controller.config%",
        "icon": "$(settings-gear)",
        "when": "obi.contains_obi_project"
      },
      {
        "command": "obi.controller.dependency-list",
        "title": "%obi.controller.dependency-list%",
        "icon": "$(outline-view-icon)",
        "when": "obi.contains_obi_project && obi.valid-config"
      },
      {
        "command": "obi.source.edit-compile-config",
        "title": "%obi.source.edit-compile-config%",
        "icon": "$(settings-gear)",
        "when": "obi.contains_obi_project"
      },
      {
        "command": "obi.transfer-all",
        "title": "%obi.transfer-all%",
        "icon": "$(cloud-upload)",
        "when": "obi.contains_obi_project && obi.valid-config",
        "enablement": "!obi.busy"
      },
      {
        "command": "obi.source-filter.show-view",
        "title": "%obi.source-filter.show-view%",
        "icon": "$(preview)",
        "when": "obi.contains_obi_project && obi.valid-config"
      },
      {
        "command": "obi.source-filter.edit-config",
        "title": "%obi.source-filter.edit-config%",
        "icon": "$(settings-gear)",
        "when": "obi.contains_obi_project && obi.valid-config"
      },
      {
        "command": "obi.source-filter.delete-config",
        "title": "%obi.source-filter.delete-config%",
        "icon": "$(trash)",
        "when": "obi.contains_obi_project && obi.valid-config"
      },
      {
        "command": "obi.source-filter.view-source-infos",
        "title": "%obi.source-filter.view-source-infos%",
        "icon": "$(preview)",
        "when": "obi.contains_obi_project && obi.valid-config"
      },
      {
        "command": "obi.source-filter.maintain-source-infos",
        "title": "%obi.source-filter.maintain-source-infos%",
        "icon": "$(settings-gear)",
        "when": "obi.contains_obi_project && obi.valid-config"
      },
      {
        "command": "obi.source-filter.add-source-file",
        "title": "%obi.source-filter.add-source-file%",
        "icon": "$(add)",
        "when": "obi.contains_obi_project && obi.valid-config"
      },
      {
        "command": "obi.source-filter.add-source-member",
        "title": "%obi.source-filter.add-source-member%",
        "icon": "$(add)",
        "when": "obi.contains_obi_project && obi.valid-config"
      },
      {
        "command": "obi.source-filter.change-source-description",
        "title": "%obi.source-filter.change-source-description%",
        "icon": "$(preview)",
        "when": "obi.contains_obi_project && obi.valid-config"
      },
      {
        "command": "obi.source-filter.rename-source-member",
        "title": "%obi.source-filter.rename-source-member%",
        "when": "obi.contains_obi_project && obi.valid-config"
      },
      {
        "command": "obi.source-filter.delete-source-member",
        "title": "%obi.source-filter.delete-source-member%",
        "when": "obi.contains_obi_project && obi.valid-config"
      },
      {
        "command": "obi.source.maintain-source-dependency",
        "title": "%obi.source.maintain-source-dependency%",
        "icon": "$(combine)",
        "when": "obi.contains_obi_project && obi.valid-config"
      },
      {
        "command": "obi.deployment.maintain",
        "title": "%obi.deployment.maintain%",
        "icon": "$(rocket)",
        "when": "obi.contains_obi_project"
      },
      {
        "command": "obi.deployment.open-web-app",
        "title": "%obi.deployment.open-web-app%",
        "icon": "$(globe)",
        "when": "obi.contains_obi_project"
      },
      {
        "command": "obi.build-history.update",
        "title": "%obi.build-history.update%"
      },
      {
        "command": "obi.build-history.search",
        "title": "%obi.build-history.search%",
        "icon": "$(search)"
      },
      {
        "command": "obi.build-history.switch-to-source-view",
        "title": "%obi.build-history.switch-to-source-view%",
        "icon": "$(references)"
      },
      {
        "command": "obi.build-history.switch-to-date-view",
        "title": "%obi.build-history.switch-to-date-view%",
        "icon": "$(calendar)"
      },
      {
        "command": "obi.build-history.delete-item",
        "title": "%obi.build-history.delete-item%",
        "icon": "$(trash)"
      },
      {
        "command": "obi.build-history.delete-date",
        "title": "%obi.build-history.delete-date%",
        "icon": "$(trash)"
      },
      {
        "command": "obi.build-history.delete-all",
        "title": "%obi.build-history.delete-all%",
        "icon": "$(clear-all)"
      },
      {
        "command": "obi.open.file",
        "title": "%obi.open.file%"
      },
      {
        "command": "obi.source-quick-search",
        "title": "%obi.source-quick-search%",
        "icon": "$(search)"
      },
      {
        "command": "obi.show.tools",
        "category": "OBI",
        "title": "%obi.show.tools%"
      },
      {
        "command": "obi.ssh.forget-host-key",
        "title": "%obi.ssh.forget-host-key%"
      },
      {
        "command": "obi.build.show-output",
        "title": "%obi.build.show-output%",
        "icon": "$(output)"
      },
      {
        "command": "obi.status-bar.menu",
        "title": "%obi.status-bar.menu%"
      },
      {
        "command": "obi.initialize-folder",
        "title": "%obi.initialize-folder%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "obi.clearDiagnostics",
          "when": "obi.contains_obi_project && (resourceExtname == .pgm || resourceExtname == .srvpgm || resourceExtname == .module || resourceExtname == .file)",
          "group": "navigation"
        },
        {
          "command": "obi.show_single_changes",
          "when": "obi.contains_obi_project && (resourceExtname == .pgm || resourceExtname == .srvpgm || resourceExtname == .module || resourceExtname == .file)",
          "group": "navigation"
        },
        {
          "command": "obi.run_single_build",
          "when": "obi.contains_obi_project && (resourceExtname == .pgm || resourceExtname == .srvpgm || resourceExtname == .module || resourceExtname == .file)",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "obi.source-quick-search",
          "when": "obi.contains_obi_project && obi.valid-config && view == obi.source-filter",
          "group": "navigation@0"
        },
        {
          "command": "obi.source-filter.add",
          "when": "obi.contains_obi_project && obi.valid-config && view == obi.source-filter",
          "group": "navigation@1"
        },
        {
          "command": "obi.source-filter.view-source-infos",
          "when": "obi.contains_obi_project && obi.valid-config && view == obi.source-filter",
          "group": "navigation@2"
        },
        {
          "command": "obi.source-filter.maintain-source-infos",
          "when": "obi.contains_obi_project && obi.valid-config && view == obi.source-filter",
          "group": "navigation@3"
        },
        {
          "command": "obi.source-filter.update",
          "when": "obi.contains_obi_project && obi.valid-config && view == obi.source-filter",
          "group": "navigation@5"
        },
        {
          "command": "obi.reset-compiled-object-list",
          "when": "obi.contains_obi_project && (view == obi.controller || (!obi.valid-config && view == obi-config-invalid))",
          "group": "navigation@40"
        },
        {
          "command": "obi.controller.dependency-list",
          "when": "obi.contains_obi_project && (view == obi.controller || (!obi.valid-config && view == obi-config-invalid))",
          "group": "navigation@65"
        },
        {
          "command": "obi.deployment.maintain",
          "when": "obi.contains_obi_project && view == obi.controller",
          "group": "navigation@66"
        },
        {
          "command": "obi.deployment.open-web-app",
          "when": "obi.contains_obi_project && view == obi.controller",
          "group": "navigation@67"
        },
        {
          "command": "obi.controller.config",
          "when": "obi.contains_obi_project && (view == obi.controller || (!obi.valid-config && view == obi-config-invalid))",
          "group": "navigation@70"
        },
        {
          "command": "obi.deployment.maintain",
          "when": "obi.contains_obi_project && obi.valid-config && view == obi.deployment",
          "group": "navigation@1"
        },
        {
          "command": "obi.build-history.switch-to-source-view",
          "when": "view == obi.build-history && obi.build-history.view-mode == date",
          "group": "navigation@1"
        },
        {
          "command": "obi.build-history.switch-to-date-view",
          "when": "view == obi.build-history && obi.build-history.view-mode == source",
          "group": "navigation@1"
        },
        {
          "command": "obi.build-history.search",
          "when": "view == obi.build-history",
          "group": "navigation@0"
        },
        {
          "command": "obi.build-history.delete-all",
          "when": "view == obi.build-history",
          "group": "navigation@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "obi.source.edit-compile-config",
          "when": "obi.contains_obi_project"
        },
        {
          "command": "obi.source-filter.change-source-description",
          "when": "obi.contains_obi_project"
        },
        {
          "command": "obi.source.maintain-source-dependency",
          "when": "obi.contains_obi_project"
        }
      ],
      "explorer/context": [
        {
          "command": "obi.source.edit-compile-config",
          "when": "obi.contains_obi_project"
        },
        {
          "command": "obi.source-filter.change-source-description",
          "when": "obi.contains_obi_project"
        },
        {
          "command": "obi.source.maintain-source-dependency",
          "when": "obi.contains_obi_project"
        }
      ],
      "view/item/context": [
        {
          "command": "obi.source-filter.show-view",
          "when": "obi.contains_obi_project && view == obi.source-filter && viewItem == source-list",
          "group": "inline@0"
        },
        {
          "command": "obi.source-filter.edit-config",
          "when": "obi.contains_obi_project && view == obi.source-filter && viewItem == source-list",
          "group": "inline@2"
        },
        {
          "command": "obi.source-filter.delete-config",
          "when": "obi.contains_obi_project && view == obi.source-filter && viewItem == source-list",
          "group": "inline@3"
        },
        {
          "command": "obi.source.edit-compile-config",
          "when": "obi.contains_obi_project && view == obi.source-filter && viewItem == obi-source",
          "group": "inline@0"
        },
        {
          "command": "obi.source.maintain-source-dependency",
          "when": "obi.contains_obi_project && view == obi.source-filter && viewItem == obi-source",
          "group": "inline@1"
        },
        {
          "command": "obi.source-filter.change-source-description",
          "when": "obi.contains_obi_project && view == obi.source-filter && viewItem == obi-source",
          "group": "inline@1"
        },
        {
          "command": "obi.source-filter.rename-source-member",
          "when": "obi.contains_obi_project && view == obi.source-filter && viewItem == obi-source"
        },
        {
          "command": "obi.source-filter.delete-source-member",
          "when": "obi.contains_obi_project && view == obi.source-filter && viewItem == obi-source"
        },
        {
          "command": "obi.source-filter.add-source-member",
          "when": "obi.contains_obi_project && view == obi.source-filter && viewItem == source-file",
          "group": "inline@0"
        },
        {
          "command": "obi.source-filter.add-source-file",
          "when": "obi.contains_obi_project && view == obi.source-filter && viewItem == source-lib",
          "group": "inline@0"
        },
        {
          "command": "obi.build-history.delete-item",
          "when": "view == obi.build-history && viewItem == buildHistoryBuild",
          "group": "inline"
        },
        {
          "command": "obi.build-history.delete-date",
          "when": "view == obi.build-history && viewItem == buildHistoryDate",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "obi.status-bar.menu",
          "when": "false"
        },
        {
          "command": "obi.initialize-folder",
          "when": "!obi.contains_obi_project"
        },
        {
          "command": "obi.deployment.maintain",
          "when": "obi.contains_obi_project"
        },
        {
          "command": "obi.deployment.open-web-app",
          "when": "obi.contains_obi_project"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "obi-bar",
          "title": "%view.obi-bar%",
          "icon": "$(code)"
        }
      ]
    },
    "views": {
      "obi-bar": [
        {
          "type": "webview",
          "id": "obi.controller",
          "name": "%view.obi.controller%",
          "when": "obi.contains_obi_project && obi.valid-config"
        },
        {
          "type": "tree",
          "id": "obi.source-filter",
          "name": "%Source filters%",
          "when": "obi.contains_obi_project && obi.valid-config"
        },
        {
          "type": "tree",
          "id": "obi.build-history",
          "name": "%view.obi.build-history%",
          "when": "obi.contains_obi_project && obi.valid-config"
        },
        {
          "type": "webview",
          "id": "obi.quick-settings",
          "name": "%Quick settings%",
          "when": "false && obi.contains_obi_project && obi.valid-config"
        },
        {
          "type": "webview",
          "id": "obi.deployment",
          "name": "%deployment%",
          "when": "1==2 && obi.contains_obi_project && obi.valid-config"
        },
        {
          "type": "webview",
          "id": "obi-welcome",
          "name": "%Welcome%",
          "when": "!obi.contains_obi_project"
        },
        {
          "type": "webview",
          "id": "obi-config-invalid",
          "name": "%Invalid config%",
          "when": "obi.contains_obi_project && !obi.valid-config"
        }
      ]
    },
    "configuration": {
      "title": "OBI",
      "properties": {
        "obi.build.revealOutput": {
          "type": "string",
          "enum": [
            "onStart",
            "onError",
            "never"
          ],
          "enumDescriptions": [
            "%obi.build.revealOutput.onStart%",
            "%obi.build.revealOutput.onError%",
            "%obi.build.revealOutput.never%"
          ],
          "default": "onError",
          "description": "%obi.build.revealOutput%"
        },
        "obi.build.confirmRun": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%obi.build.confirmRun%"
        },
        "obi.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%obi.statusBar.enabled%"
        },
        "obi.log.writeFiles": {
          "type": "boolean",
          "default": true,
          "description": "%obi.log.writeFiles%"
        },
        "obi.log.maxFileSizeMB": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "%obi.log.maxFileSizeMB%"
        },
        "obi.buildHistory.maxBuilds": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "scope": "resource",
          "description": "%obi.buildHistory.maxBuilds%"
        },
        "obi.buildHistory.maxAgeDays": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "scope": "resource",
          "description": "%obi.buildHistory.maxAgeDays%"
        },
        "obi.backend.autoUpdateLocal": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "%obi.backend.autoUpdateLocal%"
        },
        "obi.backend.autoUpdateRemote": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "%obi.backend.autoUpdateRemote%"
        }
      }
    },
    "keybindings": [
      {
        "command": "obi.run_single_build",
        "key": "ctrl+alt+shift+b",
        "mac": "cmd+alt+shift+b",
        "when": "editorTextFocus && obi.contains_obi_project && obi.valid-config && resourceExtname =~ /^\\.(pgm|srvpgm|module|file)$/"
      },
      {
        "command": "obi.show_single_changes",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c",
        "when": "editorTextFocus && obi.contains_obi_project && obi.valid-config && resourceExtname =~ /^\\.(pgm|srvpgm|module|file)$/"
      }
    ],
    "walkthroughs": [
      {
        "id": "obi.getting-started",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "initialize",
            "title": "%walkthrough.initialize.title%",
            "description": "%walkthrough.initialize.description%",
            "media": {
              "markdown": "asserts/walkthrough/initialize.md"
            },
            "completionEvents": [
              "onContext:obi.contains_obi_project"
            ]
          },
          {
            "id": "configure",
            "title": "%walkthrough.configure.title%",
            "description": "%walkthrough.configure.description%",
            "media": {
              "markdown": "asserts/walkthrough/configure.md"
            },
            "when": "obi.contains_obi_project",
            "completionEvents": [
              "onContext:obi.valid-config"
            ]
          },
          {
            "id": "show-changes",
            "title": "%walkthrough.show-changes.title%",
            "description": "%walkthrough.show-changes.description%",
            "media": {
              "markdown": "asserts/walkthrough/show-changes.md"
            },
            "when": "obi.valid-config",
            "completionEvents": [
              "onCommand:obi.show_changes"
            ]
          },
          {
            "id": "run-build",
            "title": "%walkthrough.run-build.title%",
            "description": "%walkthrough.run-build.description%",
            "media": {
              "markdown": "asserts/walkthrough/run-build.md"
            },
            "when": "obi.valid-config",
            "completionEvents": [
              "onCommand:obi.run_build"
            ]
          },
          {
            "id": "read-more",
            "title": "%walkthrough.read-more.title%",
            "description": "%walkthrough.read-more.description%",
            "media": {
              "markdown": "asserts/walkthrough/read-more.md"
            }
          }
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "**/.obi/etc/dependency.json",
        "url": "./asserts/schemas/dependency.schema.json"
      },
      {
        "fileMatch": "**/.obi/etc/source-infos.json",
        "url": "./asserts/schemas/source-infos.schema.json"
      },
      {
        "fileMatch": "**/.obi/source-list/*.json",
        "url": "./asserts/schemas/source-filter.schema.json"
      },
      {
        "fileMatch": [
          "**/.obi/build-output/compile-list.json",
          "**/.obi/build-history/*/compile-list.json"
        ],
        "url": "./asserts/schemas/compile-list.schema.json"
      }
    ]
  },
  "scripts": {
    "clean": "node -e \"for (const d of ['out','out-test']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "vscode:prepublish": "npm run clean && npm run package",
    "compile": "node ./esbuild.js && node scripts/copy-vendor.js",
    "package": "node ./esbuild.js --production && node scripts/copy-vendor.js",
    "package:vsix": "vsce package --no-dependencies",
    "watch": "node ./esbuild.js --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "compile-tests": "tsc -p ./tsconfig.test.json",
    "watch-tests": "tsc -p ./tsconfig.test.json --watch",
    "pretest": "npm run compile && npm run compile-tests",
    "test": "node ./out-test/test/runTest.js",
    "test:unit": "npm run compile-tests && mocha --ui tdd \"out-test/test/unit/**/*.test.js\"",
    "test:coverage": "npm run pretest && node -e \"require('fs').rmSync('coverage',{recursive:true,force:true})\" && node ./out-test/test/runTest.js --coverage && c8 report",
    "lint": "eslint src/",
    "lint:ci": "eslint src/ --max-warnings 251",
    "check:repo": "node scripts/check-repo.js",
    "postinstall": "node -e \"require('fs').rmSync('node_modules/ssh2/test',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
