{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "label": "npm: watch",
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^\\s*(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Watching for changes...",
          "endsPattern": "Watching for changes..."
        }
      }
    },
    {
      "type": "npm",
      "script": "compile",
      "label": "npm: compile",
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "compile-tests",
      "label": "npm: compile-tests",
      "problemMatcher": "$tsc"
    },
    {
      // Fresh copy of the test fixture for the "Extension Tests" launch configuration.
      "label": "tests: copy workspace",
      "type": "shell",
      "command": "node -e \"const fs=require('fs');fs.rmSync('.vscode-test/workspace',{recursive:true,force:true});fs.cpSync('test-resources/appconfig','.vscode-test/workspace',{recursive:true})\"",
      "problemMatcher": []
    },
    {
      "label": "tests: prepare",
      "dependsOn": ["npm: compile", "npm: compile-tests", "tests: copy workspace"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
